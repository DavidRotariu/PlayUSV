# Conexiunea Neon prin pooler (host-ul conține "-pooler"); folosită de aplicație la rulare.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Conexiunea Neon directă (fără "-pooler"); folosită de Prisma pentru migrări.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Baza de date pentru teste (alt branch Neon sau un Postgres local). Testele o golesc, nu folosi baza principală!
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/csb_test"
# Client ID-ul OAuth din Google Cloud Console (tip "Web application").
GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# Cheie secretă lungă și aleatoare pentru semnarea JWT-urilor aplicației.
JWT_SECRET="schimba-ma-cu-un-sir-lung-si-aleator"
# Emailuri cu rol ADMIN, separate prin virgulă.
ADMIN_EMAILS="admin@usm.ro"
# Portul serverului HTTP.
PORT=3000
# development activează POST /api/auth/dev-login. Nu îl seta în producție.
NODE_ENV=development
# Cu câte zile în avans se poate rezerva (implicit 14).
BOOKING_MAX_DAYS_AHEAD=14
# Cu câte minute înainte de început se mai poate anula o rezervare (implicit 0 = până la început).
CANCEL_CUTOFF_MINUTES=0
